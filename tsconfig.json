{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@middlewares/*": ["middlewares/*"],
      "@db/*": ["database/*"],
      "@modules/*": ["modules/*"],
      "@routes/*": ["routes/*"],
      "@config/*": ["config/*"],
      "@errors/*": ["errors/*"]
    },
  
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
